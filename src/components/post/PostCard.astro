---
import type { CollectionEntry } from "astro:content"; import type { CategoryIndex } from "../../lib/categories/schema"; import PostMeta from "./PostMeta.astro"; import TagList from "./TagList.astro";
interface Props { post: CollectionEntry<"posts">; index: CategoryIndex }
const { post, index } = Astro.props; const slug = post.data.slug ?? post.id.replace(/\.(md|mdx)$/, "");
---
<article class="card"><h2><a href={`/posts/${slug}/`}>{post.data.title}</a></h2><PostMeta publishedAt={post.data.publishedAt} categoryName={index.byId.get(post.data.category)?.name}/><p>{post.data.description}</p><TagList tags={post.data.tags} limit={3}/></article>
<style>.card{padding:1.3rem 0;border-bottom:1px solid var(--color-border)}h2{margin:0;font-size:1.35rem}h2 a{text-decoration:none;color:var(--color-text)}p{margin:.55rem 0;color:var(--color-muted)}</style>
