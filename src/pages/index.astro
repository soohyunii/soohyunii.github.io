---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/post/PostCard.astro";
import { loadCategoryIndex } from "../lib/categories/load";
import { getPublishedPosts } from "../lib/content/posts";
const posts = await getPublishedPosts(); const index = loadCategoryIndex();
---

<BaseLayout title="Soohyun's Blog">
  <h1>Soohyun's Blog</h1><p>대학원 공부, 프로젝트, 개인 학습 기록을 카테고리 중심으로 정리합니다.</p>
  <section aria-labelledby="latest"><h2 id="latest">Latest posts</h2>{posts.map(post => <PostCard post={post} index={index}/>)}</section>
</BaseLayout>
