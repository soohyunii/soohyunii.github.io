---
import BaseLayout from "../layouts/BaseLayout.astro"; import {getPublishedPosts} from "../lib/content/posts"; const posts=await getPublishedPosts();
---
<BaseLayout title="Archive | Soohyun's Blog"><h1>Archive</h1><ul>{posts.map(post=><li><time>{post.data.publishedAt.getFullYear()}</time> <a href={`/posts/${post.data.slug??post.id.replace(/\.(md|mdx)$/,"")}/`}>{post.data.title}</a></li>)}</ul></BaseLayout>
