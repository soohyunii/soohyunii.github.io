---
import BaseLayout from "../../layouts/BaseLayout.astro"; import {getPublishedPosts} from "../../lib/content/posts"; const posts=await getPublishedPosts(); const tags=[...new Set(posts.flatMap(p=>p.data.tags))].sort();
---
<BaseLayout title="Tags | Soohyun's Blog"><h1>Tags</h1><ul>{tags.map(tag=><li><a href={`/tags/${encodeURIComponent(tag.toLowerCase())}/`}>#{tag}</a></li>)}</ul></BaseLayout>
