---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Search | Soohyun's Blog">
  <h1>Search</h1>
  <form role="search"><label for="search-query">Search posts</label><div class="row"><input id="search-query" name="q" type="search"/><button>Search</button></div></form>
  <p id="search-status" aria-live="polite"></p><section id="search-results"></section>
  <script>
    const input=document.querySelector<HTMLInputElement>("#search-query")!; const status=document.querySelector("#search-status")!; const results=document.querySelector("#search-results")!;
    const params=new URLSearchParams(location.search); input.value=params.get("q")??"";
    async function search(query:string){if(!query){status.textContent="검색어를 입력하세요.";return;} status.textContent="검색 중…"; results.innerHTML=""; try{const pagefindPath="/pagefind/pagefind.js";const pagefind=await import(/* @vite-ignore */ pagefindPath);const response=await pagefind.search(query);const items=await Promise.all(response.results.map((result:any)=>result.data()));status.textContent=`${items.length}개의 결과`;for(const item of items){const article=document.createElement("article");const heading=document.createElement("h2");const link=document.createElement("a");link.href=item.url;link.textContent=item.meta.title;heading.append(link);const excerpt=document.createElement("p");excerpt.innerHTML=item.excerpt;article.append(heading,excerpt);results.append(article);}}catch{status.textContent="Search is available in production preview after pnpm build.";}}
    document.querySelector("form")!.addEventListener("submit",event=>{event.preventDefault();const q=input.value.trim();history.replaceState({},"",`?q=${encodeURIComponent(q)}`);search(q);}); if(input.value) search(input.value);
  </script>
</BaseLayout>
<style>label{display:block;margin-bottom:.4rem}.row{display:flex;gap:.5rem}input{flex:1;padding:.7rem;border:1px solid var(--color-border);border-radius:.4rem}button{padding:.7rem 1rem}#search-results article{border-bottom:1px solid var(--color-border);padding:1rem 0}</style>
