---
import {render} from "astro:content"; import {getPublishedPosts} from "../../lib/content/posts"; import {loadCategoryIndex} from "../../lib/categories/load"; import {getAncestors} from "../../lib/categories/queries"; import BaseLayout from "../../layouts/BaseLayout.astro"; import Breadcrumbs from "../../components/navigation/Breadcrumbs.astro"; import PostMeta from "../../components/post/PostMeta.astro"; import TagList from "../../components/post/TagList.astro"; import TableOfContents from "../../components/post/TableOfContents.astro"; import "../../styles/prose.css";
export async function getStaticPaths(){return (await getPublishedPosts()).map(post=>({params:{slug:post.data.slug??post.id.replace(/\.(md|mdx)$/,'')},props:{post}}));} const {post}=Astro.props; const {Content,headings}=await render(post); const index=loadCategoryIndex(); const category=index.byId.get(post.data.category)!; const crumbs=[...getAncestors(index,category.id),category];
---
<BaseLayout title={`${post.data.title} | Soohyun's Blog`} description={post.data.description} activeCategoryId={category.id}><Breadcrumbs items={crumbs.map(node=>({name:node.name,href:`/category/${node.path}/`}))}/><article data-pagefind-body><h1>{post.data.title}</h1><PostMeta publishedAt={post.data.publishedAt} categoryName={category.name}/><span hidden data-pagefind-meta={`category:${category.name}`}></span>{post.data.tags.map((tag:string)=><span hidden data-pagefind-meta={`tag:${tag}`}></span>)}<div class="prose"><Content/></div><TagList tags={post.data.tags}/></article><TableOfContents slot="rightRail" headings={headings}/></BaseLayout>
